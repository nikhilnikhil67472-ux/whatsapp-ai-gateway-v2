# ==============================================================================
# WhatsApp AI Gateway v2 - Production Configuration
# ==============================================================================

# Server Configuration
PORT=800
HOST=0.0.0.0
NODE_ENV=production
APP_BASE_URL=http://localhost:800

# Unified Runner (Runs REST API, Dashboard & Baileys Connection Manager in 1 process)
UNIFIED_MODE=true

# Database Configuration (SQLite WAL mode with zero Redis dependencies)
SQLITE_DB_PATH=data/gateway.db

# Security & Encryption (AES-256-GCM 32-character key for securing credentials & tokens)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# JWT Secret for Multi-Tenant Auth Sessions
JWT_SECRET=wag_supersecret_jwt_hmac_key_2026_xyz

# Master Admin API Key (For automated headless management & Swagger calls)
ADMIN_API_KEY=wag_admin_secret_key_12345

# Worker Polling Intervals (milliseconds)
WORKER_POLL_INTERVAL_MS=2000
INSTANCE_HEALTH_INTERVAL_MS=30000

# Anti-Ban Keystroke Simulation & Pacing
BAILEYS_LOG_LEVEL=warn
OUTBOUND_PRESENCE_DELAY_MS=400
OUTBOUND_DEFAULT_RATE_LIMIT_PER_MIN=30

# Voice AI Engine (Groq Whisper Turbo ~250ms ultra-low latency & OpenAI Whisper)
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Default AI Persona Prompt
DEFAULT_AI_SYSTEM_PROMPT=You are an intelligent, friendly AI WhatsApp assistant. Respond clearly, concisely, and helpfully. Keep messages easy to read on mobile devices.
