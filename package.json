{
  "name": "whatsapp-ai-gateway-v2",
  "version": "2.0.0",
  "description": "Enterprise-grade self-hosted WhatsApp AI Gateway connecting WhatsApp Web to OpenAI, Anthropic, n8n, and webhooks",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "tsx watch src/server/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:web": "node dist/server/index.js",
    "start:worker": "node dist/worker/index.js",
    "postinstall": "node scripts/patch-whatsapp-rust-bridge.cjs",
    "test": "node --test --import tsx tests/**/*.test.ts"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "https-proxy-agent": "^9.1.0",
    "node-webpmux": "^3.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "socks-proxy-agent": "^10.1.0",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
